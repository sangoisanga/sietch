{
  "name": "sietch",
  "version": "0.1.0",
  "scripts": {
    "dev": "vite",
    "build": "npm run build:pool && npm run build:icons && npm run typecheck && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && svelte-check --tsconfig ./tsconfig.json",
    "lint": "eslint .",
    "build:pool": "node scripts/buildStarterPool.mjs",
    "build:icons": "node scripts/buildIcons.mjs"
  },
  "type": "module",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@types/node": "^26.4.1",
    "eslint": "^10.10.0",
    "fake-indexeddb": "^6.2.5",
    "idb": "^8.0.3",
    "svelte": "^5.57.0",
    "svelte-check": "^4.7.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.2.2",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.11"
  },
  "private": true
}
